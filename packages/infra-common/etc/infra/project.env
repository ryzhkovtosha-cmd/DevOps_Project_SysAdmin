# Параметры инфраструктуры. Единственное место, где задаются имена и адреса.
# Все скрипты читают этот файл, поэтому переименование сети или смена зоны
# правится здесь один раз, а не в десяти местах.
#
# Перед первым запуском обязательно замените ADMIN_CIDR и NOTIFY_EMAIL.

# --- Облако -----------------------------------------------------------------
CLOUD_ZONE_A="ru-central1-a"
CLOUD_ZONE_B="ru-central1-b"          # вторая геозона — для сервера бэкапов

# --- Сеть -------------------------------------------------------------------
# Своя VPC, а не default. Зачем: в default-сети любая новая ВМ автоматически
# оказывается соседом наших серверов. Отдельная сеть даёт контролируемый
# периметр и предсказуемую адресацию, на которую можно опереться в правилах
# фаервола.
NET_NAME="infra-net"
SUBNET_A_NAME="infra-subnet-a"
SUBNET_A_RANGE="10.128.0.0/24"
SUBNET_B_NAME="infra-subnet-b"
SUBNET_B_RANGE="10.129.0.0/24"

# --- Внутренние адреса серверов (фиксируем, чтобы не зависеть от DHCP) ------
CA_IP="10.128.0.10"
VPN_IP="10.128.0.11"
MON_IP="10.128.0.12"
BACKUP_IP="10.129.0.10"

# --- Имена ВМ ---------------------------------------------------------------
CA_VM="ca-server"
VPN_VM="vpn-server"
MON_VM="mon-server"
BACKUP_VM="backup-server"

# --- Подсеть VPN-клиентов ---------------------------------------------------
VPN_SUBNET="10.8.0.0/24"
VPN_PORT="1194"
VPN_PROTO="udp"

# --- Доступ администратора --------------------------------------------------
# ЗАМЕНИТЕ на свой публичный адрес: curl -s ifconfig.me
# Пока здесь 0.0.0.0/0, SSH открыт всему интернету — это временно допустимо
# только на этапе первичной установки.
ADMIN_CIDR="0.0.0.0/0"

SSH_USER="yc-user"
# ${HOME:-/root}: у служб systemd переменная HOME не задана, а скрипты
# работают в строгом режиме set -u, где обращение к ней — аварийный выход.
SSH_KEY="${HOME:-/root}/.ssh/id_ed25519.pub"

# --- Ресурсы ВМ -------------------------------------------------------------
VM_IMAGE_FAMILY="ubuntu-2004-lts"
VM_CORES="2"
VM_MEMORY="2G"
VM_CORE_FRACTION="20"        # 20% доля vCPU — для этих сервисов достаточно
VM_DISK_SIZE="15"

# --- Порты сервисов ---------------------------------------------------------
PORT_NODE_EXPORTER="9100"
PORT_OPENVPN_EXPORTER="9176"
PORT_PROMETHEUS="9090"
PORT_ALERTMANAGER="9093"

# --- Оповещения -------------------------------------------------------------
NOTIFY_EMAIL="sysadmin@company.ru"
SMTP_SMARTHOST="smtp.yandex.ru:587"
SMTP_FROM="alerts@company.ru"

# --- Реквизиты удостоверяющего центра --------------------------------------
CA_COUNTRY="RU"
CA_PROVINCE="Moscow"
CA_CITY="Moscow City"
CA_ORG="Our Company Name"
CA_EMAIL="sysadmin@company.ru"
CA_OU="IT Department"
