# Шаблон клиентской конфигурации. Приносится пакетом infra-vpn-config.
# Плейсхолдер @@REMOTE@@ подставляется командой infra-vpn-make-client.

client
dev tun
proto udp
remote @@REMOTE@@ 1194

resolv-retry infinite
# На публичном Wi-Fi имя сервера может не резолвиться с первой попытки.

nobind
# Клиенту не нужен фиксированный локальный порт.

persist-key
persist-tun

remote-cert-tls server
# Проверяем, что на той стороне сертификат СЕРВЕРНОГО типа. Защита от
# подставного сервера: злоумышленник с клиентским сертификатом не сможет
# притвориться шлюзом.

tls-version-min 1.2
cipher AES-256-GCM
auth SHA256
# Должны совпадать с настройками сервера.

verb 3

# mute НЕ используется на стороне клиента намеренно.
# На сервере он уместен: журнал растёт годами. У клиента сеанс короткий,
# а подавление съедает важные строки — в том числе "Initialization
# Sequence Completed", по которой судят об успешном подключении.

# Сертификаты и ключи вшиваются ниже блоками <ca>, <cert>, <key>
# и <tls-crypt> — скриптом assemble-config.sh на машине сотрудника.
# Директива key-direction здесь НЕ нужна: она относится к устаревшему
# tls-auth, а у tls-crypt ключ симметричный.
