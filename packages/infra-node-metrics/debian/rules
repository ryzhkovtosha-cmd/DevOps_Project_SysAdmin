#!/usr/bin/make -f
# Сборка через debhelper.

%:
	dh $@

# Юниты названы не по имени пакета (infra-cert-metrics), поэтому
# dh_installsystemd нужно указать имя явно — иначе он ищет только
# debian/<пакет>.service и наши файлы не находит.
#
# Два вызова с ЯВНЫМ указанием юнита в каждом. Без явного указания
# первый вызов помечает --no-enable все юниты с этим именем, включая
# таймер, и второй вызов этого уже не отменяет: таймер устанавливается,
# но в автозапуск не попадает.
override_dh_installsystemd:
	dh_installsystemd --name=infra-cert-metrics --no-enable --no-start infra-cert-metrics.service
	dh_installsystemd --name=infra-cert-metrics infra-cert-metrics.timer
