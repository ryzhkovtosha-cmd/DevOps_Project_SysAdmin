#!/usr/bin/make -f
# Сборка через debhelper.

%:
	dh $@

# Юниты названы не по имени пакета (infra-cert-metrics, а не
# infra-node-metrics), поэтому dh_installsystemd нужно указать имя явно —
# иначе он ищет только debian/<пакет>.service и наши файлы не находит.
#
# Включаем и запускаем ТОЛЬКО таймер: сама служба имеет тип oneshot,
# запускается таймером и секции [Install] не имеет.
override_dh_installsystemd:
	dh_installsystemd --name=infra-cert-metrics --no-enable --no-start
	dh_installsystemd --name=infra-cert-metrics infra-cert-metrics.timer
